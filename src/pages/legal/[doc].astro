---
import Base from '../../layouts/Base.astro';
import { LEGAL, LEGAL_NAV } from '../../data/legal';
import { breadcrumbJsonLd, withSiteName } from '../../data/seo';

export function getStaticPaths() {
  return Object.keys(LEGAL).map((doc) => ({ params: { doc }, props: { docKey: doc } }));
}

const { docKey } = Astro.props;
const doc = LEGAL[docKey]!;
const jsonLd = breadcrumbJsonLd(Astro.site, [
  { name: 'Home', path: '/' },
  { name: doc.title, path: `/legal/${docKey}/` },
]);
---

<Base title={withSiteName(doc.title)} description={doc.description} {jsonLd}>
  <div class="container legal-layout">
    <nav class="legal-nav" aria-label="Legal pages">
      <div class="sec-h">Legal</div>
      {
        LEGAL_NAV.map((n) => (
          <a href={`/legal/${n.key}/`} aria-current={n.key === docKey ? 'page' : undefined}>
            {n.label}
          </a>
        ))
      }
    </nav>
    <article class="legal-article">
      <h1 class="page-title" style="margin-top: 0">{doc.title}</h1>
      <div class="legal-updated">Last updated {doc.updated}</div>
      {
        doc.sections.map((s) => (
          <section class="legal-section">
            <h2>{s.h}</h2>
            <p>{s.p}</p>
          </section>
        ))
      }
    </article>
  </div>
</Base>
