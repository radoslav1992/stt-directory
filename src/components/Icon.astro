} as const;

interface Props {
  name: keyof typeof PATHS;
  class?: string;
  size?: number;
}

const { name, class: cls, size = 24 } = Astro.props;
---

<svg
  class={cls}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={PATHS[name]}
/>
